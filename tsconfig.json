{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"]
    }
  },
  "include": [
    "app/wms/register-warehouses.ts",
    "app/wms/account-register.server.ts",
    "app/wms/warehouse-list.server.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
